# Copy to .env.local and fill in. See MONETIZATION.md for the full setup runbook.

# Stripe (test mode keys start with sk_test_; live with sk_live_)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...        # Pro plan, $49/mo recurring
STRIPE_PRICE_ENTERPRISE=price_... # Enterprise plan, $299/mo recurring

# HMAC secret for signing license tokens (any long random string)
LICENSE_SIGNING_SECRET=...

# Public base URL of the deployed app (used in Stripe checkout redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Google OAuth (existing Drive export feature)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
AUTH_SECRET=...
